# Copy to .env — everything is optional; the app runs with no .env at all.

# LLM provider: "mock" (default, offline, no key) or "claude"
LLM_PROVIDER=mock

# Only needed when LLM_PROVIDER=claude. The key stays in the Node sidecar —
# it is never sent to the browser.
# ANTHROPIC_API_KEY=sk-ant-...

# Override the Claude model (optional)
# ANTHROPIC_MODEL=claude-opus-4-8

# Sidecar port (optional; the Vite dev server proxies /api here)
# PORT=8787

# SQLite database location (optional)
# DATABASE_URL=file:data/app.db
